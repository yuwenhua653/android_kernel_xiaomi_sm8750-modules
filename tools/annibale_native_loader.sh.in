#!/vendor/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Native source qualification only; replace the existing service's script owner.
# This is independently implemented, not derived from a proprietary loader.
set -f
fail() { echo "annibale module load: $*" >&2; exit 1; }
check_alias() {
    alias_path=$1
    expected_path=$2
    # modules.dep uses Android's /system and /vendor aliases, even though
    # modules.load is read directly from the dedicated DLKM mount.
    [ -L "$alias_path" ] || fail "missing module symlink: $alias_path"
    resolved_path=$(CDPATH= cd -P "$alias_path" && pwd -P) || fail "broken module symlink: $alias_path"
    [ "$resolved_path" = "$expected_path" ] || fail "wrong module symlink: $alias_path -> $resolved_path"
}
load_list() {
    directory=$1
    [ -s "$directory/modules.load" ] || fail "missing/empty $directory/modules.load"
    [ -s "$directory/modules.dep" ] || fail "missing/empty $directory/modules.dep"
    # Validate the entire list before inserting any module from this partition.
    while IFS= read -r module || [ -n "$module" ]; do
        case "$module" in
            ''|*[!A-Za-z0-9_.-]*|.*|-*|*..*) fail "invalid module name: $module" ;;
            *.ko) ;;
            *) fail "missing .ko suffix: $module" ;;
        esac
        [ -f "$directory/$module" ] || fail "missing $directory/$module"
    done < "$directory/modules.load"
    while IFS= read -r module || [ -n "$module" ]; do
        /vendor/bin/modprobe -b -d "$directory" -a "$module" || fail "insertion failed: $module"
        loaded_name=$(printf '%s' "${module%.ko}" | /vendor/bin/tr '-' '_') || fail "module name conversion failed"
        [ -d "/sys/module/$loaded_name" ] || fail "module absent after modprobe: $module"
    done < "$directory/modules.load"
}
mode='@MODE@'
if [ "$mode" = vendor ]; then
    /vendor/bin/setprop vendor.all.modules.ready 0 || fail "cannot clear ready property"
fi
[ "$(/vendor/bin/uname -r)" = '@RELEASE@' ] || fail "kernel release mismatch"
check_alias /system/lib/modules /system_dlkm/lib/modules
if [ "$mode" = vendor ]; then
    check_alias /vendor/lib/modules /vendor_dlkm/lib/modules
fi
@BOOT_CHECKS@
# Repeat this prerequisite in the vendor service: init can continue after a failed
# exec_start gki.modprobe. modprobe is idempotent for already inserted modules.
load_list /system_dlkm/lib/modules
if [ "$mode" = vendor ]; then
    load_list /vendor_dlkm/lib/modules
    /vendor/bin/setprop vendor.all.modules.ready 1 || fail "cannot set ready property"
fi
