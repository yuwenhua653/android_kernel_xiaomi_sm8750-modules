--- /dev/null
+++ b/sepolicy/vendor/hal_minetaidlservice.te
@@ -0,0 +1,31 @@
+# OS4 merged MiNet/SLA service. Diagnostic shell/module-loading paths are not
+# granted here; full target policy/neverallow and runtime checks are required.
+hal_attribute(minetaidlservice)
+hal_attribute(miwillservice)
+
+type hal_minetaidlservice_default, domain;
+type hal_minetaidlservice_default_exec, exec_type, vendor_file_type, file_type;
+type hal_minetaidlservice_service, hal_service_type, protected_service, service_manager_type;
+type hal_miwillservice_service, hal_service_type, protected_service, service_manager_type;
+
+init_daemon_domain(hal_minetaidlservice_default)
+hal_server_domain(hal_minetaidlservice_default, hal_minetaidlservice)
+hal_server_domain(hal_minetaidlservice_default, hal_miwillservice)
+hal_server_domain(hal_minetaidlservice_default, hal_slaaidlservice)
+hal_attribute_service(hal_minetaidlservice, hal_minetaidlservice_service)
+hal_attribute_service(hal_miwillservice, hal_miwillservice_service)
+binder_use(hal_minetaidlservice_default)
+binder_call(hal_minetaidlservice_client, hal_minetaidlservice_server)
+binder_call(hal_minetaidlservice_server, hal_minetaidlservice_client)
+binder_call(hal_miwillservice_client, hal_miwillservice_server)
+binder_call(hal_miwillservice_server, hal_miwillservice_client)
+hal_client_domain(system_app, hal_minetaidlservice)
+hal_client_domain(system_server, hal_minetaidlservice)
+hal_client_domain(system_app, hal_miwillservice)
+hal_client_domain(system_server, hal_miwillservice)
+hal_client_domain(system_app, hal_slaaidlservice)
+hal_client_domain(system_server, hal_slaaidlservice)
+set_prop(hal_minetaidlservice_default, vendor_minetd_prop)
+set_prop(hal_minetaidlservice_default, vendor_slad_prop)
+unix_socket_connect(hal_minetaidlservice_default, minetd, minetd)
+unix_socket_connect(hal_minetaidlservice_default, slad, slad)
--- /dev/null
+++ b/sepolicy/vendor/minetd.te
@@ -0,0 +1,16 @@
+# Minimal stock-derived daemon ownership; no blanket vendor execution grant.
+type minetd, domain;
+type minetd_exec, exec_type, vendor_file_type, file_type;
+type minetd_socket, file_type;
+type minetd_data_file, file_type, data_file_type;
+vendor_internal_prop(vendor_minetd_prop)
+init_daemon_domain(minetd)
+net_domain(minetd)
+set_prop(minetd, vendor_minetd_prop)
+allow minetd self:capability { net_admin net_raw };
+allow minetd self:netlink_generic_socket { read write create getattr bind setopt };
+allow minetd self:netlink_route_socket nlmsg_write;
+allow minetd self:packet_socket { read create bind setopt shutdown };
+allow minetd minetd_socket:sock_file { getattr read write unlink };
+allow minetd minetd_data_file:dir create_dir_perms;
+allow minetd minetd_data_file:file create_file_perms;
